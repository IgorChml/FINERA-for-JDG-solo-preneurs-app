// FINERA — Prisma Schema
// Database: PostgreSQL (AWS RDS eu-central-1 — RODO compliance)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USER
// ============================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  passwordResetToken String?
  passwordResetExpiry DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile              JDGProfile?
  subscription         Subscription?
  refreshTokens        RefreshToken[]
  invoices             Invoice[]
  costs                Cost[]
  taxReserves          TaxReserve[]
  ksefToken            KSeFToken?
  ksefSyncJobs         KSeFSyncJob[]
  pushTokens           PushToken[]
  insightReports       InsightReport[]
  lessonProgress       UserLessonProgress[]
  aiCallLogs           AiCallLog[]
  subscriptionStatus   SubscriptionPlan2    @default(FREE)
  subscriptionExpiry   DateTime?
  revenuecatUserId     String?              @unique
  ocrUsedThisMonth     Int                  @default(0)
  ocrResetDate         DateTime?

  @@map("users")
}

enum SubscriptionPlan2 {
  FREE
  TRIAL
  PREMIUM
  EXPIRED

  @@map("subscription_plan2")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  token       String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model PushToken {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  platform    String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

// ============================================================
// JDG PROFILE
// ============================================================

model JDGProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  companyName             String
  nip                     String    @unique
  regon                   String?
  pkdCode                 String?
  taxForm                 TaxForm
  vatRate                 Int       @default(23)
  isVatPayer              Boolean   @default(true)
  lumpSumRate             Float?
  street                  String
  houseNumber             String
  apartmentNumber         String?
  postalCode              String
  city                    String
  country                 String    @default("PL")
  bankAccountNumber       String?
  taxMicroaccountNumber   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jdg_profiles")
}

enum TaxForm {
  SCALE
  LINEAR
  LUMP_SUM
}

// ============================================================
// SUBSCRIPTION
// ============================================================

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  plan                  SubscriptionPlan   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime
  trialEnd              DateTime?
  revenuecatCustomerId  String?
  revenuecatProductId   String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

// ============================================================
// KSEF INTEGRATION
// ============================================================

model KSeFToken {
  id           String           @id @default(cuid())
  userId       String           @unique
  token        String
  environment  KSeFEnvironment  @default(DEMO)
  status       KSeFTokenStatus  @default(ACTIVE)
  lastSyncAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ksef_tokens")
}

model KSeFSyncJob {
  id              String         @id @default(cuid())
  userId          String
  status          KSeFSyncStatus @default(PENDING)
  environment     KSeFEnvironment @default(DEMO)
  invoicesFetched Int            @default(0)
  invoicesNew     Int            @default(0)
  errorMessage    String?
  startedAt       DateTime       @default(now())
  completedAt     DateTime?

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("ksef_sync_jobs")
}

enum KSeFEnvironment {
  DEMO
  PRODUCTION
}

enum KSeFTokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
  INVALID
}

enum KSeFSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id              String         @id @default(cuid())
  userId          String
  type            InvoiceType
  source          InvoiceSource  @default(MANUAL)
  status          InvoiceStatus  @default(DRAFT)
  invoiceNumber   String
  issueDate       DateTime
  dueDate         DateTime
  paymentDate     DateTime?
  sellerName      String
  sellerNip       String
  sellerAddress   String?
  buyerName       String
  buyerNip        String?
  buyerAddress    String?
  netAmount       Decimal        @db.Decimal(15, 2)
  vatAmount       Decimal        @db.Decimal(15, 2)
  grossAmount     Decimal        @db.Decimal(15, 2)
  currency        String         @default("PLN")
  ksefId          String?        @unique
  ksefNumber      String?
  pdfUrl          String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           InvoiceItem[]
  costs           Cost[]

  @@index([userId, type, status])
  @@index([userId, issueDate])
  @@index([ksefId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  name        String
  quantity    Decimal  @db.Decimal(12, 4)
  unitPrice   Decimal  @db.Decimal(15, 2)
  vatRate     Int
  unit        String   @default("szt")
  netAmount   Decimal  @db.Decimal(15, 2)
  vatAmount   Decimal  @db.Decimal(15, 2)
  grossAmount Decimal  @db.Decimal(15, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

enum InvoiceType {
  INCOME
  COST
}

enum InvoiceSource {
  MANUAL
  KSEF
  SCAN
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ============================================================
// COSTS
// ============================================================

model Cost {
  id               String       @id @default(cuid())
  userId           String
  invoiceId        String?
  amount           Decimal      @db.Decimal(15, 2)
  vatAmount        Decimal?     @db.Decimal(15, 2)
  netAmount        Decimal?     @db.Decimal(15, 2)
  currency         String       @default("PLN")
  category         CostCategory
  vendor           String
  vendorNip        String?
  description      String?
  date             DateTime
  receiptImageUrl  String?
  aiRiskLevel      AiRiskLevel?
  aiRiskReason     String?
  aiLegalBasis     String?
  isDeductible     Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice          Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([userId, date])
  @@index([userId, category])
  @@map("costs")
}

enum CostCategory {
  OFFICE
  TRANSPORT
  MARKETING
  SOFTWARE
  HARDWARE
  PROFESSIONAL_SERVICES
  PHONE_INTERNET
  FOOD_BUSINESS
  TRAINING
  INSURANCE
  OTHER
}

enum AiRiskLevel {
  GREEN
  YELLOW
  RED
}

// ============================================================
// TAX RESERVES
// ============================================================

model TaxReserve {
  id              String   @id @default(cuid())
  userId          String
  month           Int
  year            Int
  revenue         Decimal  @db.Decimal(15, 2)
  costs           Decimal  @db.Decimal(15, 2)
  vatOwed         Decimal  @db.Decimal(15, 2)
  pitOwed         Decimal  @db.Decimal(15, 2)
  zusHealthOwed   Decimal  @db.Decimal(15, 2)
  zusSocialOwed   Decimal  @db.Decimal(15, 2)
  totalOwed       Decimal  @db.Decimal(15, 2)
  reservedAmount  Decimal  @db.Decimal(15, 2) @default(0)
  isPaid          Boolean  @default(false)
  paymentDate     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId, year])
  @@map("tax_reserves")
}

// ============================================================
// AI INSIGHT ENGINE — Phase 2
// ============================================================

model InsightReport {
  id            String      @id @default(cuid())
  userId        String
  period        String
  periodType    PeriodType
  generatedAt   DateTime    @default(now())
  cachedUntil   DateTime
  narrative     String
  metrics       Json
  promptVersion String      @default("insight-v1")
  tokensUsed    Int         @default(0)
  userRating    Int?

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period])
  @@map("insight_reports")
}

enum PeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

model PromptVersion {
  id           String   @id @default(cuid())
  name         String   @unique
  systemPrompt String
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("prompt_versions")
}

// ============================================================
// AI CALL LOGGING — Phase 2
// ============================================================

model AiCallLog {
  id           String    @id @default(cuid())
  userId       String?
  module       AiModule
  inputTokens  Int
  outputTokens Int
  latencyMs    Int
  success      Boolean
  errorMessage String?
  createdAt    DateTime  @default(now())

  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, module, createdAt])
  @@map("ai_call_logs")
}

enum AiModule {
  OCR_EXTRACTION
  OCR_RISK_AUDIT
  INSIGHT_NARRATIVE
}

// ============================================================
// EDUCATION PLATFORM — Phase 2
// ============================================================

model EducationCategory {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  icon      String
  sortOrder Int

  lessons   EducationLesson[]

  @@map("education_categories")
}

model EducationLesson {
  id              String               @id @default(cuid())
  categoryId      String
  slug            String               @unique
  title           String
  summary         String
  contentMdx      String
  taxFormFilter   String[]             @default(["ALL"])
  updatedAt       DateTime             @updatedAt
  publishedAt     DateTime?
  legalSource     String?
  readTimeMinutes Int                  @default(5)

  category        EducationCategory    @relation(fields: [categoryId], references: [id])
  quizQuestions   QuizQuestion[]
  userProgress    UserLessonProgress[]

  @@index([categoryId, publishedAt])
  @@map("education_lessons")
}

model QuizQuestion {
  id          String          @id @default(cuid())
  lessonId    String
  question    String
  answers     Json
  explanation String
  sortOrder   Int             @default(0)

  lesson      EducationLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model UserLessonProgress {
  id          String          @id @default(cuid())
  userId      String
  lessonId    String
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  quizScore   Int?

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      EducationLesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("user_lesson_progress")
}
