# ============================================================
# FINERA API — Environment Variables
# Copy to .env and fill in values. NEVER commit .env!
# ============================================================

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
API_BASE_URL=http://localhost:3001

# Database (AWS RDS PostgreSQL eu-central-1 — RODO)
DATABASE_URL=postgresql://finera:password@localhost:5432/finera_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_min_64_chars
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret_min_64_chars

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@finera.pl

# SMS (Twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+48...

# KSeF
KSEF_DEMO_URL=https://ksef-demo.mf.gov.pl/api
KSEF_PROD_URL=https://ksef.mf.gov.pl/api

# Tink Open Banking
TINK_CLIENT_ID=...
TINK_CLIENT_SECRET=...
TINK_REDIRECT_URI=finera://tink-callback

# RevenueCat
REVENUECAT_WEBHOOK_SECRET=...

# AWS (for Secrets Manager & S3)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=finera-receipts

# CORS
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081

# Frontend URL
MOBILE_DEEP_LINK=finera://
WEB_URL=https://app.finera.pl
